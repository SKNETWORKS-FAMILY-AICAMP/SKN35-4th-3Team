# 복사: Copy-Item .env.example .env
# 반드시 실제 비밀번호와 생성한 Django SECRET_KEY로 변경한다.

MYSQL_DATABASE=shopdb 
MYSQL_USER=shopuser 
MYSQL_PASSWORD=change-this-app-password
MYSQL_ROOT_PASSWORD=change-this-root-password
MYSQL_HOST=127.0.0.1 
MYSQL_PORT=3310
DJANGO_SECRET_KEY=replace-with-a-generated-secret
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,testserver
DJANGO_DEBUG=True

# 국가법령정보센터 판례 검색·상세 조회 인증값
LAW_API_OC=

# 4차 Qdrant 컬렉션: 4차 청크와 3차에서 복사한 판례를 검색합니다.
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=SKN35-4th-3Team
QDRANT_VECTOR_NAME=
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536
OPENAI_MODEL=gpt-5-nano

# 답변 생성·첨부파일 제한
GENERATOR_MAX_OUTPUT_TOKENS=1200
GENERATOR_CONTEXT_CHARS=12000
CHAT_UPLOAD_MAX_BYTES=10485760
CHAT_PDF_MAX_PAGES=5
CHAT_MAX_IMAGE_FILES=3

# 선택 기능: 값이 없으면 RRF 검색 점수를 그대로 사용합니다.
RERANK_MODEL=
RERANK_MIN_SCORE=0.1
SPARSE_EMBEDDING_MODEL=Qdrant/bm25
QDRANT_SPARSE_VECTOR_NAME=bm25
