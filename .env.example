# 복사: Copy-Item .env.example .env
# 반드시 실제 비밀번호와 생성한 Django SECRET_KEY로 변경한다.

MYSQL_DATABASE=shopdb 
MYSQL_USER=shopuser 
MYSQL_PASSWORD=change-this-app-password
MYSQL_ROOT_PASSWORD=change-this-root-password
MYSQL_HOST=127.0.0.1 
MYSQL_PORT=3310
DJANGO_SECRET_KEY=replace-with-a-generated-secret
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,testserver
DJANGO_DEBUG=True

# 국가법령정보센터 판례 검색·상세 조회 인증값
LAW_API_OC=

# 3차 프로젝트 Qdrant 판례 검색(기존 데이터는 변경하지 않고 읽기만 합니다.)
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=team_documents_openai_dev
QDRANT_VECTOR_NAME=
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536
OPENAI_MODEL = gpt-5-nano
